{
	"name": "fcc-exercise-tracker",
	"version": "1.0.0",
	"main": "dist/index.js",
	"author": "Jake Klassen",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"clean": "shx rm -rf dist",
		"prebuild": "pnpm run clean",
		"build": "node --loader tsm src/build.ts",
		"build:only": "node --loader tsm src/build.ts",
		"compile-schemas": "json2ts -i src/schemas -o src/types",
		"lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" eslint.config.mjs",
		"lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" eslint.config.mjs",
		"premigrate": "pnpm run build",
		"migrate": "node --env-file=.env dist/migrate.js",
		"watch": "tsc --watch",
		"start": "nodemon",
		"migrate:test": "node --env-file=.env.test dist/migrate.js up",
		"pretest": "run-s build migrate:test",
		"test": "node --env-file=.env.test node_modules/mocha/bin/_mocha",
		"prod": "node ./dist",
		"typecheck": "tsc"
	},
	"imports": {
		"#app/*": [
			"./dist/*"
		]
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.41",
		"async-cleanup": "^1.0.0",
		"awilix": "^12.0.5",
		"bson": "^6.10.4",
		"change-case": "^5.4.4",
		"comment-json": "^4.4.1",
		"convict": "^6.2.4",
		"fastify": "^4.29.1",
		"fp-ts": "^2.16.11",
		"http-status-codes": "^2.3.0",
		"io-ts": "^2.2.22",
		"json-schema-to-typescript": "15.0.4",
		"mongodb": "^6.20.0",
		"mongoose": "8.19.1",
		"monocle-ts": "^2.3.13",
		"newtype-ts": "^0.3.5",
		"pino": "10.0.0",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.2",
		"reflect-metadata": "^0.2.2",
		"tslog": "^4.10.2",
		"typescript": "^5.9.3",
		"umzug": "^3.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@eslint/eslintrc": "^3.2.0",
		"@ngneat/falso": "8.0.2",
		"@types/convict": "6.1.6",
		"@types/mocha": "10.0.10",
		"@types/node": "24.7.2",
		"@types/wtfnode": "0.10.0",
		"@typescript-eslint/eslint-plugin": "8.46.1",
		"@typescript-eslint/parser": "8.46.1",
		"clipboardy": "5.0.0",
		"esbuild": "0.28.2",
		"eslint": "9.37.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-depend": "^1.3.1",
		"eslint-plugin-prettier": "5.5.4",
		"expect": "30.2.0",
		"get-port": "7.1.0",
		"get-port-cli": "3.0.0",
		"globals": "^16.4.0",
		"mocha": "11.7.4",
		"nodemon": "3.1.10",
		"npm-run-all": "4.1.5",
		"prettier": "3.6.2",
		"shx": "0.4.0",
		"tiny-glob": "0.2.9",
		"ts-node": "10.9.2",
		"tsm": "2.3.0",
		"typescript-eslint": "^8.46.1",
		"wtfnode": "0.10.1"
	}
}
